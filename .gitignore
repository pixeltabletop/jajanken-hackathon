# Dependencias y salidas de construcción. Las rutas propias del proyecto van
# ancladas con barra inicial: sin ella, la regla vale para cualquier carpeta con
# ese nombre en cualquier nivel del árbol.
node_modules
/out
/dist/

# Modelos y cachés de QVAC
*.gguf
.qvac/
.smoke-userdata/

# Registros y clips de prueba de dictado. La barra inicial importa: `audio/` sin
# anclar también taparía `src/renderer/src/audio/`, que sí es código.
*.log*
/audio/

# Documentos del reto que son de Philips, no nuestros: se usan para trabajar y
# derivar la semilla, pero no se redistribuyen dentro de nuestra entrega.
reference/
data/Dummy_Installed_Base_Hackathon.xlsx

# Artefactos muertos del arranque del proyecto
docs/briefing.html
resources/seed-observations.json

# Sistema y editor
.DS_Store
.eslintcache
